# ========================
# SERVER
# ========================
NODE_ENV=development
PORT=5999

# Base URL of the frontend. Used to build verification / password-reset links
# in real emails. Use http://localhost:5173 for local development and the real
# deployed SkillHub URL in production.
FRONTEND_URL=http://localhost:5173

# ========================
# DATABASE
# ========================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillhub?retryWrites=true&w=majority

# ========================
# JWT
# ========================
# In production (NODE_ENV=production), these must be:
#  - Unique from each other
#  - At least 48 characters
#  - NOT contain 'change_this_in_production', 'your_super_secret', or 'example'
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email Verification (OTP)
OTP_SECRET=change_this_to_a_long_random_string
# OTP_TTL_MS=600000  # 10 minutes
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_MS=60000  # 60 seconds
# OTP_MAX_RESENDS=5

# ========================
# EMAIL (SMTP — real email delivery)
# ========================
# SkillHub sends REAL emails through an SMTP provider (Gmail SMTP, Mailgun,
# Brevo/Sendinblue, Postmark, Amazon SES, etc.). Put placeholder values here —
# NEVER commit real credentials. Real values go in your .env file.
#
# IMPORTANT — Contact Us admin replies:
#   The admin "Reply" flow delivers to the sender's REAL mailbox and uses
#   requireReal: true, so it NEVER falls back to the Ethereal test transport.
#   If EMAIL_USER / EMAIL_PASSWORD are blank or placeholders, the reply is
#   stored with emailStatus="Failed" and the admin sees the exact reason.
#   Other development flows (signup verification, password reset) still fall
#   back to an auto-created Ethereal test account and log preview URLs.
#
# Gmail setup: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as EMAIL_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Set to true only for SMTP servers that require SSL/TLS on connect (usually 465).
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_app_password
# EMAIL_PASS is a legacy alias for EMAIL_PASSWORD (supported for backward compatibility).
EMAIL_FROM=SkillHub <noreply@skillhub.dev>
EMAIL_FROM_NAME=SkillHub
# Optional socket/DNS timeouts (ms). Defaults below. Keep them short so a slow
# or unreachable SMTP host fails fast instead of hanging requests.
EMAIL_CONNECTION_TIMEOUT=15000
EMAIL_GREETING_TIMEOUT=15000
EMAIL_SOCKET_TIMEOUT=30000
EMAIL_DNS_TIMEOUT=10000
# NOTE: the backend resolves EMAIL_HOST via the OS resolver (dns.lookup) and
# connects to the resolved IP using the hostname as the TLS servername. This
# avoids "queryA ETIMEOUT <host>" failures when Nodemailer's own resolver path
# points at an unreachable local DNS (e.g. a VPN's 127.0.0.1).

# ========================
# CLOUDINARY
# ========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# STRIPE
# ========================
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ========================
# PAYMENT MODE
# "demo" = fake deposits (no real money, no API keys needed)
# "chapa" = real Chapa integration (requires CHAPA_SECRET_KEY)
# ========================
PAYMENT_MODE=demo

# ========================
# WEBHOOK SIGNATURES (Telebirr / CBE Birr)
# When operating in "demo" mode these are optional: incoming webhooks are still
# signature-verified when a secret is configured, and unverified payloads fail
# closed (return non-2xx) so the provider retries. In real deployments you MUST
# set a strong random secret (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# and configure the same value in the Telebirr/CBE Birr merchant dashboard
# signature settings. The verifier supports the payload fields
# sign / signature / hmac / webhookSign and the headers
# x-signature / x-webhook-signature / signature.
TELEBIRR_WEBHOOK_SECRET=
CBE_BIRR_WEBHOOK_SECRET=

# ========================
# CHAPA (Ethiopia) — required when PAYMENT_MODE=chapa
# ========================
CHAPA_SECRET_KEY=CHAPUBK_TEST-xxxxx
CHAPA_PUBLIC_KEY=CHAPUBK-xxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1

# ========================
# AI PROVIDER
# "gemini" = Google Gemini (default, free tier available)
# ========================
AI_PROVIDER=gemini

# Set to true only if you later want to re-enable OpenAI as a provider.
AI_OPENAI_ENABLED=false

# ========================
# GEMINI (Primary AI — free tier available)
# ========================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# Quota guards (optional). The free tier allows ~20 generateContent calls/day
# shared by every AI feature, so the backend keeps a local budget, pauses calls
# after a 429, and reuses identical prompts.
# AI_MAX_REQUESTS_PER_DAY=15
# AI_RESPONSE_CACHE_TTL_MS=300000
# AI_QUOTA_COOLDOWN_MS=60000

# ========================
# OPENAI (DISABLED by default — kept for future opt-in)
# ========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ========================
# REDIS (Optional - for caching)
# ========================
REDIS_URL=redis://localhost:6379

# ========================
# GITHUB
# ========================
GITHUB_TOKEN=ghp_xxxxx

# ========================
# PLATFORM SETTINGS
# ========================
PLATFORM_COMMISSION_RATE=0.10
PLATFORM_NAME=SkillHub
# Minimum a freelancer may charge for any pricing package (basic/standard/premium).
MIN_PACKAGE_PRICE=1
