  "howItWorks": {
    "title": "A smarter way to work together",
    "subtitle": "From posting a project to getting paid — every step is designed for transparency, security, and speed.",
    "badge": "How SkillHub Works",
    "forClients": "For Clients",
    "forFreelancers": "For Freelancers",
    "step": "Step",
    "clients": {
      "step1": { "title": "Post Your Project", "desc": "Create your project, set your budget, define milestones, and use AI to write a clear job description." },
      "step2": { "title": "AI Matches Top Talent", "desc": "AI analyzes skills, experience, portfolios, and reputation to recommend the best-fit freelancers." },
      "step3": { "title": "Review & Hire with Confidence", "desc": "Compare proposals, verified skills, reviews, and candidates before making your decision." },
      "step4": { "title": "Fund Escrow Securely", "desc": "Fund your project securely. Your money stays protected until you approve the completed milestone." },
      "step5": { "title": "Collaborate in Real-Time", "desc": "Chat, share files, track milestones, preview work, and manage your project in one workspace." },
      "step6": { "title": "Approve & Release Payment", "desc": "Review the work, request revisions when needed, and release payment after approving the milestone." },
      "step7": { "title": "Build Long-Term Partnerships", "desc": "Save trusted freelancers, build teams, and continue working with professionals you know and trust." }
    },
    "freelancers": {
      "step1": { "title": "Build Your Verified Profile", "desc": "Showcase your skills, portfolio, and experience. Get verified to earn trusted badges." },
      "step2": { "title": "Discover Matching Projects", "desc": "Browse curated jobs matched to your skills and get AI-powered recommendations." },
      "step3": { "title": "Submit Winning Proposals", "desc": "Craft winning proposals with smart templates and AI-suggested pricing, timelines, and highlights." },
      "step4": { "title": "Interview & Get Hired", "desc": "Connect via live chat or video, showcase your expertise, and negotiate terms." },
      "step5": { "title": "Work with Payment Protection", "desc": "Work with confidence — escrowed funds are guaranteed and you track milestones and deliverables." },
      "step6": { "title": "Get Paid Instantly", "desc": "Funds transfer instantly to your wallet after milestone approval. Withdraw anytime." },
      "step7": { "title": "Level Up Your Career", "desc": "Earn badges, build your reputation, and unlock premium opportunities and exclusive clients." }
    }
  },
